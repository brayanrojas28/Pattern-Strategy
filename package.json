{
  "name": "strategy-pattern-playground",
  "private": true,
  "version": "0.0.0",
  "description": "A hands-on playground for learning and practicing the Strategy design pattern in TypeScript.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.16.0",
    "eslint-config-prettier": "10.1.9",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "^8.0.1",
    "vitest": "4.1.12"
  }
}
